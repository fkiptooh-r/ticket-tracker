PORT=4000

# Neon: pooled connection string, used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"

# Neon: direct (unpooled) connection string, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Origin of the Next.js client, for CORS
CLIENT_ORIGIN="http://localhost:3000"
